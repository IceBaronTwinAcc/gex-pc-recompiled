set(CMAKE_SYSTEM_NAME Darwin)
set(GEX_MACOS_ARCH arm64 CACHE STRING "macOS CPU architecture: arm64 or x86_64")
set_property(CACHE GEX_MACOS_ARCH PROPERTY STRINGS arm64 x86_64)
if(NOT GEX_MACOS_ARCH MATCHES "^(arm64|x86_64)$")
    message(FATAL_ERROR "GEX_MACOS_ARCH must be arm64 or x86_64")
endif()
set(CMAKE_SYSTEM_PROCESSOR "${GEX_MACOS_ARCH}")
get_filename_component(GEX_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(GEX_OSXCROSS_ROOT "${GEX_SOURCE_ROOT}/.deps/osxcross" CACHE PATH "OSXCross checkout")
set(GEX_MACOS_PREFIX "${GEX_SOURCE_ROOT}/.deps/macos-${GEX_MACOS_ARCH}" CACHE PATH "macOS dependencies")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    GEX_OSXCROSS_ROOT GEX_OSXCROSS_TARGET GEX_OSXCROSS_RESOURCE_DIR GEX_MACOS_PREFIX GEX_MACOS_ARCH)
if(NOT GEX_OSXCROSS_TARGET)
    file(GLOB compilers "${GEX_OSXCROSS_ROOT}/target/bin/${GEX_MACOS_ARCH}-apple-darwin*-clang")
    list(FILTER compilers EXCLUDE REGEX "-cmake-clang$")
    list(LENGTH compilers count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Build ${GEX_MACOS_ARCH} OSXCross first, or set GEX_OSXCROSS_TARGET explicitly")
    endif()
    list(GET compilers 0 compiler)
    get_filename_component(compiler "${compiler}" NAME)
    string(REGEX REPLACE "-clang$" "" GEX_OSXCROSS_TARGET "${compiler}")
endif()
set(GEX_OSXCROSS_TARGET "${GEX_OSXCROSS_TARGET}" CACHE STRING "OSXCross target triple")
if(NOT GEX_OSXCROSS_TARGET MATCHES "^${GEX_MACOS_ARCH}-apple-darwin")
    message(FATAL_ERROR "GEX_OSXCROSS_TARGET must match GEX_MACOS_ARCH; use a separate build directory")
endif()
set(tools "${GEX_OSXCROSS_ROOT}/target/bin/${GEX_OSXCROSS_TARGET}")
set(CMAKE_C_COMPILER "${tools}-clang")
set(CMAKE_CXX_COMPILER "${tools}-clang++")
set(CMAKE_OBJC_COMPILER "${tools}-clang")
set(CMAKE_OBJCXX_COMPILER "${tools}-clang++")
set(CMAKE_AR "${tools}-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${tools}-ranlib" CACHE FILEPATH "")
set(CMAKE_INSTALL_NAME_TOOL "${tools}-install_name_tool" CACHE FILEPATH "")
set(GEX_OSXCROSS_RESOURCE_DIR "${GEX_OSXCROSS_ROOT}/target/lib/clang/runtime"
    CACHE PATH "Clang resources with the Apple compiler runtime")
if(NOT EXISTS "${GEX_OSXCROSS_RESOURCE_DIR}/lib/darwin/libclang_rt.osx.a")
    message(FATAL_ERROR "Install the Apple compiler runtime in GEX_OSXCROSS_RESOURCE_DIR; see docs/development.md")
endif()
foreach(language C CXX OBJC OBJCXX)
    set(CMAKE_${language}_FLAGS_INIT "-resource-dir=${GEX_OSXCROSS_RESOURCE_DIR}")
endforeach()
if(NOT CMAKE_OSX_SYSROOT)
    file(GLOB sdks "${GEX_OSXCROSS_ROOT}/target/SDK/MacOSX*.sdk")
    list(LENGTH sdks count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Set CMAKE_OSX_SYSROOT to the macOS SDK")
    endif()
    list(GET sdks 0 CMAKE_OSX_SYSROOT)
endif()
set(CMAKE_OSX_SYSROOT "${CMAKE_OSX_SYSROOT}" CACHE PATH "")
set(CMAKE_OSX_ARCHITECTURES "${GEX_MACOS_ARCH}" CACHE STRING "")
if(NOT CMAKE_OSX_ARCHITECTURES STREQUAL GEX_MACOS_ARCH)
    message(FATAL_ERROR "CMAKE_OSX_ARCHITECTURES must match GEX_MACOS_ARCH; build each architecture separately")
endif()
set(CMAKE_OSX_DEPLOYMENT_TARGET 13.0 CACHE STRING "")
set(CMAKE_FIND_ROOT_PATH "${GEX_MACOS_PREFIX}" "${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_FRAMEWORK LAST)
set(ENV{PKG_CONFIG_LIBDIR} "${GEX_MACOS_PREFIX}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "")
